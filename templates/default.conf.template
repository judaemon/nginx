# Default "nginx is running" page for localhost and ${DEFAULT_DOMAIN}.
# For HTTPS, see default-ssl.conf.template.example.
server {
    listen 80;
    server_name localhost ${DEFAULT_DOMAIN};

    include /etc/nginx/snippets/acme-challenge.conf;

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}
