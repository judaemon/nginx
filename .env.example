# Copy to .env on each machine and set that environment's values.

# Production only: also load docker-compose.prod.yml (certbot renewals).
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Domain for the default "nginx is running" page (also served on localhost).
# *.localhost resolves to 127.0.0.1 without editing /etc/hosts.
DEFAULT_DOMAIN=nginx.localhost

# Strict-Transport-Security header value. Leave empty locally (header not sent).
# Production: HSTS=max-age=63072000; includeSubDomains
HSTS=

# Add one variable per site template, e.g. APP_DOMAIN=app.localhost locally
# and APP_DOMAIN=app.example.com in production.
APP_DOMAIN=app.localhost
