.PHONY: reload-nginx restart-nginx up down render test-config clear-logs logs sites cert-local cert cert-status cloudflare

reload-nginx: test-config
	docker compose exec nginx nginx -s reload

# Recreate rather than restart: a plain restart keeps the environment from when the
# container was created, so .env changes would be ignored
restart-nginx:
	docker compose up -d --force-recreate nginx

up:
	docker compose up -d

down:
	docker compose down

# Re-render templates/*.template into /etc/nginx/sites (only runs automatically at container start).
# Fails if .env or the compose files changed since the container was created (its
# environment would be stale) or if a template uses a variable that is not set.
render:
	@if docker compose up -d --dry-run nginx 2>&1 | grep -q Recreate; then \
		echo "nginx container is older than .env or the compose files: run 'make up' first"; exit 1; fi
	docker compose exec -e STRICT=1 nginx sh -c 'rm -f /etc/nginx/sites/*.conf && /docker-entrypoint.d/20-envsubst-on-templates.sh'

test-config: render
	docker compose exec nginx nginx -t

clear-logs:
	docker compose exec nginx sh -c "rm -f /var/log/nginx/*.log"
	docker compose exec nginx nginx -s reopen

logs:
	docker compose logs -f nginx

# Show the rendered site configs nginx is actually using
sites:
	docker compose exec nginx sh -c 'tail -n +1 /etc/nginx/sites/*.conf'

# Local: trusted certificate from mkcert, stored where Let's Encrypt would put it
cert-local:
	@test -n "$(DOMAIN)" || { echo "Usage: make cert-local DOMAIN=app.localhost"; exit 1; }
	mkdir -p letsencrypt/live/$(DOMAIN)
	mkcert -cert-file letsencrypt/live/$(DOMAIN)/fullchain.pem \
		-key-file letsencrypt/live/$(DOMAIN)/privkey.pem $(DOMAIN)

# Production: issue a Let's Encrypt certificate. Add STAGING=1 to test without hitting rate limits.
cert:
	@test -n "$(DOMAIN)" || { echo "Usage: make cert DOMAIN=app.example.com [EMAIL=you@example.com] [STAGING=1]"; exit 1; }
	docker compose run --rm --entrypoint certbot certbot certonly --webroot -w /var/www/certbot \
		-d $(DOMAIN) --non-interactive --agree-tos \
		$(if $(EMAIL),--email $(EMAIL) --no-eff-email,--register-unsafely-without-email) \
		$(if $(STAGING),--staging)

# Production: list certificates and their expiry dates
cert-status:
	docker compose run --rm --entrypoint certbot certbot certificates

# Trust Cloudflare's proxy IPs so logs and apps see the real visitor IP.
# Re-run to refresh the IP list; disable with `rm snippets/real-ip/cloudflare.conf`.
cloudflare:
	@{ echo "# Generated by 'make cloudflare' from https://www.cloudflare.com/ips/"; \
	   for ip in $$(curl -fsS https://www.cloudflare.com/ips-v4) $$(curl -fsS https://www.cloudflare.com/ips-v6); do \
	     echo "set_real_ip_from $$ip;"; done; \
	   echo "real_ip_header CF-Connecting-IP;"; } > snippets/real-ip/cloudflare.conf.tmp
	@grep -q set_real_ip_from snippets/real-ip/cloudflare.conf.tmp \
		&& mv snippets/real-ip/cloudflare.conf.tmp snippets/real-ip/cloudflare.conf \
		|| { rm -f snippets/real-ip/cloudflare.conf.tmp; echo "Failed to fetch Cloudflare IPs"; exit 1; }
	$(MAKE) reload-nginx
